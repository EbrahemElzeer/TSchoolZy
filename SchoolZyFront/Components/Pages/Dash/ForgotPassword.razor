@page "/ForgotPassword"
@inject HttpClient Http

@layout MainLayout
@using Application.Dto
@using System.Net.Http.Json
@using SchoolZyFront.Components.Layout



<div class="form-container">
    <h2>Forgot Password</h2>

    <EditForm Model="forgotModel" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
     

        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <InputText id="email" type="email" class="form-control" @bind-Value="forgotModel.Email" />
            <ValidationMessage For="@(() => forgotModel.Email)" class="validation-error" />
        </div>

        <button type="submit" class="btn btn-primary" disabled="@isLoading">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true">Sending...</span>
               
                        } 
            else
            {
                <span>Send Reset Link</span>
            }
        </button>
    </EditForm>

    @if (submitted)
    {
        <p class="text-success mt-3">Reset link sent to your email.</p>
    }
</div>

@code {
    private ForgotPasswordDto forgotModel = new();
    private bool submitted = false;
    private bool isLoading = false;

    private async Task HandleSubmit()
    {
        submitted = false;
        isLoading = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/forgot-password", forgotModel);
            if (response.IsSuccessStatusCode)
            {
                submitted = true;
                forgotModel = new ForgotPasswordDto(); // Reset form
            }
            else
            {
                var errorMsg = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error sending reset email: {response.StatusCode} - {errorMsg}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception: " + ex.Message);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
