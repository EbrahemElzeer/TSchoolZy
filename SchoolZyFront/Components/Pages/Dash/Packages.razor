@page "/dashboard/Packages"
@using Application.Dto
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@layout DashboardLayout
@attribute [Authorize]
<h3>Manage Packages</h3>

<button class="btn btn-primary mb-3" @onclick="ShowAddPackageForm">Add New Package</button>

@if (loading)
{
    <p>Loading packages...</p>
}
else if (showForm)
{
    <EditForm Model="packageModel" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label>Name</label>
            <InputText class="form-control" @bind-Value="packageModel.Name" />
            <ValidationMessage For="@(() => packageModel.Name)" class="validation-error mt-2" />
        </div>

        <div class="mb-3">
            <label>Icon Path</label>
            <InputText class="form-control" @bind-Value="packageModel.IconPath" />
            <small class="form-text text-muted">: /images/icons/package-icon.png</small>
            <ValidationMessage For="@(() => packageModel.IconPath)" class="validation-error mt-2" />
        </div>

        <div class="mb-3">
            <label>Price</label>
            <InputNumber class="form-control" @bind-Value="packageModel.Price" />
            <ValidationMessage For="@(() => packageModel.Price)" class="validation-error mt-2" />
        </div>

        <div class="mb-3">
            <label>Features</label>
            @foreach (var feature in packageModel.Features)
            {
                <div class="input-group mb-2">
                    <InputText class="form-control" @bind-Value="feature.FeatureText" />
                    <ValidationMessage For="@(() => feature.FeatureText)" class="validation-error mt-2" />
                    <button type="button" class="btn btn-danger" @onclick="() => RemoveFeature(feature)">Remove</button>
                </div>
            }
            <button type="button" class="btn btn-secondary" @onclick="AddFeature">Add Feature</button>
        </div>

        <button type="submit" class="btn btn-success me-2">Save</button>
        <button type="button" class="btn btn-secondary" @onclick="HideForm">Cancel</button>
    </EditForm>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Icon</th>
                <th>Features</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pkg in packages)
            {
                <tr>
                    <td>@pkg.Name</td>
                    <td>
                        @if (!string.IsNullOrEmpty(pkg.IconPath))
                        {
                            <img src="@pkg.IconPath" alt="@pkg.Name" style="height:40px;" />
                        }
                    </td>
                    <td>
                        <ul>
                            @foreach (var f in pkg.Features)
                            {
                                <li>@f.FeatureText</li>
                            }
                        </ul>
                    </td>
                    <td>@pkg.Price.ToString("C")</td>
                    <td>
                        <button class="btn btn-sm btn-warning me-2" @onclick="() => EditPackage(pkg)">Edit</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeletePackage(pkg.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    List<PackageDto> packages = new();
    PackageDto packageModel = new PackageDto() { Features = new List<PackageFeatureDto>() };
    bool showForm = false;
    bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPackages();
    }

    async Task LoadPackages()
    {
        try
        {
            loading = true;
            packages = await Http.GetFromJsonAsync<List<PackageDto>>("api/packages");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error loading packages: " + ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    void ShowAddPackageForm()
    {
        packageModel = new PackageDto() { Features = new List<PackageFeatureDto>() };
        showForm = true;
    }

    void HideForm()
    {
        showForm = false;
    }

    void EditPackage(PackageDto pkg)
    {
        packageModel = new PackageDto
        {
            Id = pkg.Id,
            Name = pkg.Name,
            IconPath = pkg.IconPath,
            Price = pkg.Price,
            IsUpdate = true,
            Features = pkg.Features.Select(f => new PackageFeatureDto { Id = f.Id, FeatureText = f.FeatureText }).ToList()
        };
        showForm = true;
    }

    void AddFeature()
    {
        packageModel.Features.Add(new PackageFeatureDto());
    }

    void RemoveFeature(PackageFeatureDto feature)
    {
        packageModel.Features.Remove(feature);
    }

    async Task DeletePackage(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this package?");
        if (!confirmed) return;

        try
        {
            var response = await Http.DeleteAsync($"api/packages/{id}");
            if (response.IsSuccessStatusCode)
            {
                packages.RemoveAll(p => p.Id == id);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error deleting package: " + ex.Message);
        }
    }

    async Task HandleValidSubmit()
    {
        try
        {
            if (packageModel.IsUpdate)
            {
                var response = await Http.PutAsJsonAsync($"api/packages/{packageModel.Id}", packageModel);
                if (response.IsSuccessStatusCode)
                {
                    var pkgToUpdate = packages.FirstOrDefault(p => p.Id == packageModel.Id);
                    if (pkgToUpdate != null)
                    {
                        pkgToUpdate.Name = packageModel.Name;
                        pkgToUpdate.IconPath = packageModel.IconPath;
                        pkgToUpdate.Price = packageModel.Price;
                        pkgToUpdate.Features = packageModel.Features.Select(f => new PackageFeatureDto { Id = f.Id, FeatureText = f.FeatureText }).ToList();
                    }
                }
            }
            else
            {
                var response = await Http.PostAsJsonAsync("api/packages", packageModel);
                if (response.IsSuccessStatusCode)
                {
                    var newPackage = await response.Content.ReadFromJsonAsync<PackageDto>();
                    packages.Add(newPackage);
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error saving package: " + ex.Message);
        }

        showForm = false;
    }

    [Inject]
    IJSRuntime JS { get; set; }
}
