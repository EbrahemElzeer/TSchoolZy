@page "/Dashboard/reset-password"
@inject HttpClient Http
@inject NavigationManager NavManager

@layout MainLayout
@using Application.Dto
@using System.Net.Http.Json
@using Microsoft.AspNetCore.WebUtilities
@using SchoolZyFront.Components.Layout

<div class="form-container" style="max-width:400px; margin: 2rem auto; padding: 1.5rem; border: 1px solid #ddd; border-radius: 8px; background-color: #fff;">
    <h2 class="mb-4 text-center">Reset Password</h2>

    <EditForm Model="resetModel" OnValidSubmit="HandleReset">
        <DataAnnotationsValidator />
        

        <div class="mb-3">
            <label class="form-label" for="newPassword">New Password</label>
            <InputText id="newPassword" type="password" class="form-control" @bind-Value="resetModel.NewPassword" />
            <ValidationMessage For="@(() => resetModel.NewPassword)" class="validation-error" />
        </div>

        <button type="submit" class="btn btn-primary w-100" disabled="@isSubmitting">
            @(isSubmitting ? "Resetting..." : "Reset Password")
        </button>
    </EditForm>

    @if (submitted)
    {
        <div class="alert alert-success mt-3" role="alert">
            Password has been reset successfully. Redirecting to login...
        </div>
    }
</div>

@code {
    private ResetPasswordDto resetModel = new ResetPasswordDto();
    private bool submitted = false;
    private bool isSubmitting = false;

    protected override void OnInitialized()
    {
        var uri = new Uri(NavManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("email", out var email))
            resetModel.Email = email;

        if (query.TryGetValue("token", out var token))
            resetModel.Token = token;
    }

    private async Task HandleReset()
    {
        isSubmitting = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/reset-password", resetModel);

            if (response.IsSuccessStatusCode)
            {
                submitted = true;
                // تأخير بسيط عشان يشوف المستخدم الرسالة قبل إعادة التوجيه
                await Task.Delay(2000);
                NavManager.NavigateTo("/login");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"Error: {response.StatusCode} - {error}");
                // هنا ممكن تضيف رسالة خطأ تظهر للمستخدم لو حبيت
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception: " + ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
